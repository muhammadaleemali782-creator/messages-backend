MAIL_DOMAIN=yourdomain.com
MAIL_FROM=no-reply@yourdomain.com
SMTP_PORT=25
API_PORT=3000

# MongoDB Atlas connection string (free tier available at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mailserver

# generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_random_64_char_hex_string

# your real frontend origin in production (e.g. https://mail.yourcompany.com)
# Required for CORS to allow the separately-hosted frontend to call this API.
ALLOWED_ORIGIN=http://localhost:5500

# 'lax' = frontend and backend on the same site (e.g. same domain, different
#         subdomain) - recommended default, safer against CSRF.
# 'none' = frontend and backend on completely different domains - REQUIRES
#          HTTPS (secure cookie) even in development, browsers reject
#          SameSite=None cookies over plain HTTP.
COOKIE_SAME_SITE=lax

NODE_ENV=development

# api-only | receiver-only | (leave unset for both, e.g. plain VPS dev use)
RUN_MODE=
